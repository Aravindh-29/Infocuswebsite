  "version": "1.0.0",
  "description": "Infocus Consulting Services - responsive static technology website",
  "main": "nav.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/fix-static-segments.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
